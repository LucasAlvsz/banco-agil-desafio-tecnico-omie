# Copie para .env e preencha a chave do provedor selecionado.
# Nunca faça commit do arquivo .env.
LLM_MODEL=groq/openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=45
EXCHANGE_TIMEOUT_SECONDS=8
# Câmbio via MCP. Opções: inmemory (padrão), stdio e streamable_http.
# MCP_EXCHANGE_TRANSPORT=inmemory
# MCP_EXCHANGE_URL=http://127.0.0.1:8001/mcp
DATA_DIR=data

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=

# Exemplos: substitua LLM_MODEL e preencha as credenciais correspondentes.
# Groq: LLM_MODEL=groq/openai/gpt-oss-120b e GROQ_API_KEY
# Gemini: LLM_MODEL=gemini/gemini-2.5-flash e GEMINI_API_KEY
# OpenAI: LLM_MODEL=openai/gpt-4o-mini e OPENAI_API_KEY
# OpenRouter: LLM_MODEL=openrouter/openai/gpt-4o-mini e OPENROUTER_API_KEY
# Amazon Bedrock: LLM_MODEL=bedrock/anthropic.claude-3-haiku-20240307-v1:0
# e AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION_NAME (ex.: us-east-1).
# Variáveis já preenchidas no ambiente do processo têm precedência sobre .env.

# Langfuse opcional. As duas chaves são necessárias para exportar traces.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# UI em modo HTTP. Deixe API_BASE_URL vazia para executar em memória.
# API_BASE_URL=http://localhost:8000
# API_TIMEOUT_SECONDS=60
